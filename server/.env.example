NODE_ENV=development
PORT=5000
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_MAX=20
MESSAGE_RATE_LIMIT_WINDOW_MS=60000
MESSAGE_RATE_LIMIT_MAX=30
REVIEW_REPORT_THRESHOLD=3

JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Required for multi-instance/production deployments.
REDIS_URL=
# Production fails to start unless REDIS_URL is set or this is explicitly enabled
# for a single-instance deployment. Local state is never distributed-safe.
ALLOW_INSECURE_NO_REDIS=false
TRUST_PROXY=false
LOG_LEVEL=info

MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_CONNECT_RETRIES=3
MONGO_TRANSACTIONS_DISABLED=false

OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_CLAIM_TIMEOUT_MS=60000

SHUTDOWN_TIMEOUT_MS=10000

# Used only by `npm run admin:bootstrap`; never commit real values.
# ADMIN_NAME=
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
