{
  "name": "skillswap",
  "version": "1.0.0",
  "private": true,
  "description": "SkillSwap full-stack application foundation",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "admin:bootstrap": "npm run admin:bootstrap --workspace server",
    "preview": "npm run preview --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
